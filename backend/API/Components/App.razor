<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>

    @* --- jQuery (dependencia de Toastr) --- *@
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
