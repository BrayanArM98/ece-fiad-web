    @* --- SweetAlert2 --- *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="js/sweetalert2.js"></script>

    @* --- Configuración inicial de Toastr --- *@
    <script>
        toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "5000",
        };
    </script>
