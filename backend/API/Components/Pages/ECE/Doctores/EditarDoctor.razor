@page "/editar-doctor/{id:int}"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Editar Doctor: @(doctorOriginal?.NombreCompleto ?? "...")
                    </h5>
                </div>
                <div class="card-body p-4">

                    @if (doctorOriginal == null || especialidades == null)
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-spinner fa-pulse me-2"></i>Cargando datos del doctor...
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@doctorEditar" OnValidSubmit="@GrabarDoctor">
                            <FluentValidator />

                            @* ====== Campo de solo lectura: Id ====== *@
                            <div class="mb-3">
                                <label for="id" class="form-label fw-semibold text-muted">
                                    <i class="fas fa-hashtag me-1"></i> Id del doctor
                                </label>
                                <InputNumber id="id" class="form-control bg-light"
                                             @bind-Value="doctorEditar.Id" readonly />
                            </div>

                            <div class="alert alert-warning py-2 px-3 mb-3">
                                <i class="fas fa-edit me-1"></i> <strong>Datos editables</strong>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="nombres" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Nombres
                                    </label>
                                    <InputText id="nombres" class="form-control"
                                               @bind-Value="doctorEditar.Nombres" />
                                    <ValidationMessage For="@(() => doctorEditar.Nombres)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="apellidos" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Apellidos
                                    </label>
                                    <InputText id="apellidos" class="form-control"
                                               @bind-Value="doctorEditar.Apellidos" />
                                    <ValidationMessage For="@(() => doctorEditar.Apellidos)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="telefono" class="form-label fw-semibold">
                                        <i class="fas fa-phone me-1"></i> Teléfono
                                    </label>
                                    <InputText id="telefono" class="form-control"
                                               @bind-Value="doctorEditar.Telefono" />
                                    <ValidationMessage For="@(() => doctorEditar.Telefono)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label fw-semibold">
                                        <i class="fas fa-envelope me-1"></i> Correo electrónico
                                    </label>
                                    <InputText id="email" class="form-control"
                                               @bind-Value="doctorEditar.Email" />
                                    <ValidationMessage For="@(() => doctorEditar.Email)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="especialidad" class="form-label fw-semibold">
                                    <i class="fas fa-stethoscope me-1"></i> Especialidad
                                </label>
                                <InputSelect id="especialidad" class="form-select"
                                             @bind-Value="doctorEditar.IdEspecialidad">
                                    <option value="0">-- Selecciona una especialidad --</option>
                                    @foreach (var esp in especialidades)
                                    {
                                        <option value="@esp.Id">@esp.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => doctorEditar.IdEspecialidad)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="horario" class="form-label fw-semibold">
                                    <i class="fas fa-clock me-1"></i> Horario de atención
                                    <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="horario" class="form-control" rows="3"
                                               @bind-Value="doctorEditar.HorarioAtencion" />
                                <ValidationMessage For="@(() => doctorEditar.HorarioAtencion)" class="text-danger small" />
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i> Actualizar Doctor
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>