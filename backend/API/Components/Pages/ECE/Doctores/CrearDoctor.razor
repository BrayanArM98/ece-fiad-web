@page "/crear-doctor"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success bg-gradient text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Registro de nuevo doctor
                    </h5>
                </div>
                <div class="card-body p-4">

                    @if (especialidades == null)
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-spinner fa-pulse me-2"></i>Cargando especialidades...
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@doctorDto" OnValidSubmit="@GrabarDoctor">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="nombres" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Nombres
                                    </label>
                                    <InputText id="nombres" class="form-control"
                                               placeholder="Ej: Juan Carlos"
                                               @bind-Value="doctorDto.Nombres" />
                                    <ValidationMessage For="@(() => doctorDto.Nombres)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="apellidos" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Apellidos
                                    </label>
                                    <InputText id="apellidos" class="form-control"
                                               placeholder="Ej: Pérez López"
                                               @bind-Value="doctorDto.Apellidos" />
                                    <ValidationMessage For="@(() => doctorDto.Apellidos)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="telefono" class="form-label fw-semibold">
                                        <i class="fas fa-phone me-1"></i> Teléfono
                                    </label>
                                    <InputText id="telefono" class="form-control"
                                               placeholder="Ej: 6461234567"
                                               @bind-Value="doctorDto.Telefono" />
                                    <ValidationMessage For="@(() => doctorDto.Telefono)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label fw-semibold">
                                        <i class="fas fa-envelope me-1"></i> Correo electrónico
                                    </label>
                                    <InputText id="email" class="form-control"
                                               placeholder="Ej: doctor@correo.com"
                                               @bind-Value="doctorDto.Email" />
                                    <ValidationMessage For="@(() => doctorDto.Email)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="especialidad" class="form-label fw-semibold">
                                    <i class="fas fa-stethoscope me-1"></i> Especialidad
                                </label>
                                <InputSelect id="especialidad" class="form-select"
                                             @bind-Value="doctorDto.IdEspecialidad">
                                    <option value="0">-- Selecciona una especialidad --</option>
                                    @foreach (var esp in especialidades)
                                    {
                                        <option value="@esp.Id">@esp.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => doctorDto.IdEspecialidad)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="horario" class="form-label fw-semibold">
                                    <i class="fas fa-clock me-1"></i> Horario de atención
                                    <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="horario" class="form-control" rows="3"
                                               placeholder="Ej: Lunes a Viernes de 8:00 a 14:00"
                                               @bind-Value="doctorDto.HorarioAtencion" />
                                <ValidationMessage For="@(() => doctorDto.HorarioAtencion)" class="text-danger small" />
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save me-1"></i> Guardar Doctor
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>