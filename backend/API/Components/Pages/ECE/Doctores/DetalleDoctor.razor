@page "/detalles-doctor/{id:int}"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white text-center rounded-top-4">
                    <h4 class="mb-0">
                        <i class="fas fa-user-md me-2"></i>
                        @(doctor?.NombreCompleto ?? "Detalles del Doctor")
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (doctor == null)
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>Cargando información...
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Nombres
                                </label>
                                <div class="form-control bg-light">
                                    <strong>@doctor.Nombres</strong>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-1"></i> Apellidos
                                </label>
                                <div class="form-control bg-light">
                                    <strong>@doctor.Apellidos</strong>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-phone me-1"></i> Teléfono
                                </label>
                                <div class="form-control bg-light">
                                    @doctor.Telefono
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-envelope me-1"></i> Correo electrónico
                                </label>
                                <div class="form-control bg-light">
                                    @doctor.Email
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">
                                <i class="fas fa-stethoscope me-1"></i> Especialidad
                            </label>
                            <div class="form-control bg-light">
                                <span class="badge bg-primary">@doctor.NombreEspecialidad</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">
                                <i class="fas fa-clock me-1"></i> Horario de atención
                            </label>
                            <div class="form-control bg-light" style="min-height: 60px;">
                                @if (string.IsNullOrEmpty(doctor.HorarioAtencion))
                                {
                                    <span class="text-muted fst-italic">Sin horario registrado</span>
                                }
                                else
                                {
                                    @doctor.HorarioAtencion
                                }
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-calendar-check me-1"></i> Citas asociadas
                                </label>
                                <div class="form-control bg-light">
                                    <span class="badge bg-info">@doctor.CantidadCitas</span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-muted">
                                    Estado
                                </label>
                                <div class="form-control bg-light">
                                    @if (doctor.Activo)
                                    {
                                        <span class="text-success fw-bold">
                                            <i class="fas fa-check-circle me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fw-bold">
                                            <i class="fas fa-times-circle me-1"></i> Inactivo
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button class="btn btn-secondary" @onclick="Volver">
                                <i class="fas fa-arrow-left me-1"></i> Volver al listado
                            </button>
                            <button class="btn btn-primary" @onclick="Editar">
                                <i class="fas fa-edit me-1"></i> Editar doctor
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>