@page "/doctores"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-user-md me-2"></i>Listado de Doctores
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nuevo Doctor
                </button>
            </div>
        </div>
        <div class="card-body p-3 bg-primary-subtle">

            @if (doctores == null)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-pulse fa-2x text-primary"></i>
                    <p class="mt-2">Cargando doctores...</p>
                </div>
            }
            else if (!doctores.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay doctores registrados.
                    <a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Crear el primero</a>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3 p-2">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre completo</th>
                                <th>Especialidad</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Horario</th>
                                <th class="text-center">Citas</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in doctores)
                            {
                                <tr>
                                    <td><strong>@doc.NombreCompleto</strong></td>
                                    <td>
                                        <span class="badge bg-primary">@doc.NombreEspecialidad</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-phone text-muted me-1"></i>@doc.Telefono
                                    </td>
                                    <td>
                                        <i class="fas fa-envelope text-muted me-1"></i>@doc.Email
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(doc.HorarioAtencion))
                                        {
                                            <span class="text-muted fst-italic">Sin horario</span>
                                        }
                                        else
                                        {
                                            @(doc.HorarioAtencion.Length > 30 ? doc.HorarioAtencion.Substring(0, 30) + "..." : doc.HorarioAtencion)
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@doc.CantidadCitas</span>
                                    </td>
                                    <td class="text-center">
                                        @if (doc.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(doc.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(doc.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(doc.Id, doc.NombreCompleto, doc.CantidadCitas)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>