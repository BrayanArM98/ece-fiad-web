@page "/editar-historia/{Id:int}"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning bg-gradient text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Editar Historia Clínica
                    </h5>
                </div>
                <div class="card-body p-4">

                    @if (cargando)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando datos de la historia clínica...</p>
                        </div>
                    }
                    else if (historiaEditar == null)
                    {
                        <div class="alert alert-danger text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No se encontró la historia clínica solicitada.
                        </div>
                        <div class="text-center mt-3">
                            <button class="btn btn-secondary" @onclick="Cancelar">
                                <i class="fas fa-arrow-left me-1"></i> Volver al listado
                            </button>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@historiaEditar" OnValidSubmit="@GrabarHistoria" FormName="formEditarHistoria">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="paciente" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Paciente
                                    </label>
                                    <input type="text" id="paciente" class="form-control" readonly
                                           value="@nombrePaciente" />
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        El paciente no se puede modificar al editar.
                                    </small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="fecha" class="form-label fw-semibold">
                                        <i class="fas fa-calendar-day me-1"></i> Fecha de Apertura
                                    </label>
                                    <InputDate id="fecha" class="form-control"
                                               @bind-Value="historiaEditar.FechaApertura" />
                                    <ValidationMessage For="@(() => historiaEditar.FechaApertura)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="alergias" class="form-label fw-semibold">
                                    <i class="fas fa-allergies me-1"></i> Alergias <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="alergias" class="form-control" rows="3"
                                               @bind-Value="historiaEditar.Alergias" />
                                <small class="text-muted">
                                    @(historiaEditar.Alergias?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaEditar.Alergias)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="antFam" class="form-label fw-semibold">
                                    <i class="fas fa-users me-1"></i> Antecedentes Familiares <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="antFam" class="form-control" rows="3"
                                               @bind-Value="historiaEditar.AntecedentesFamiliares" />
                                <small class="text-muted">
                                    @(historiaEditar.AntecedentesFamiliares?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaEditar.AntecedentesFamiliares)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="antPers" class="form-label fw-semibold">
                                    <i class="fas fa-user-injured me-1"></i> Antecedentes Personales <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="antPers" class="form-control" rows="3"
                                               @bind-Value="historiaEditar.AntecedentesPersonales" />
                                <small class="text-muted">
                                    @(historiaEditar.AntecedentesPersonales?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaEditar.AntecedentesPersonales)" class="text-danger small" />
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox id="activo" class="form-check-input"
                                               @bind-Value="historiaEditar.Activo" />
                                <label for="activo" class="form-check-label fw-semibold">
                                    Historia clínica activa
                                </label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="fas fa-save me-1"></i> Actualizar Historia
                                </button>
                            </div>
                        </EditForm>
                    }

                </div>
            </div>
        </div>
    </div>
</div>