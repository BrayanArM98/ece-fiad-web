@page "/crear-historia"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success bg-gradient text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Registro de Nueva Historia Clínica
                    </h5>
                </div>
                <div class="card-body p-4">

                    @if (cargando)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando datos del formulario...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@historiaDto" OnValidSubmit="@GrabarHistoria" FormName="formCrearHistoria">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="paciente" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Paciente
                                    </label>
                                    <InputSelect id="paciente" class="form-select"
                                                 @bind-Value="historiaDto.IdPaciente">
                                        <option value="0">-- Selecciona un paciente --</option>
                                        @foreach (var pac in pacientes!)
                                        {
                                            <option value="@pac.Id">@pac.Nombres @pac.Apellidos</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => historiaDto.IdPaciente)" class="text-danger small" />
                                    @if (pacientes != null && !pacientes.Any())
                                    {
                                        <small class="text-warning">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            Todos los pacientes tienen historia clínica activa.
                                        </small>
                                    }
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="fecha" class="form-label fw-semibold">
                                        <i class="fas fa-calendar-day me-1"></i> Fecha de Apertura
                                    </label>
                                    <InputDate id="fecha" class="form-control"
                                               @bind-Value="historiaDto.FechaApertura" />
                                    <ValidationMessage For="@(() => historiaDto.FechaApertura)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="alergias" class="form-label fw-semibold">
                                    <i class="fas fa-allergies me-1"></i> Alergias <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="alergias" class="form-control" rows="3"
                                               placeholder="Ej: Penicilina, mariscos..."
                                               @bind-Value="historiaDto.Alergias" />
                                <small class="text-muted">
                                    @(historiaDto.Alergias?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaDto.Alergias)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="antFam" class="form-label fw-semibold">
                                    <i class="fas fa-users me-1"></i> Antecedentes Familiares <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="antFam" class="form-control" rows="3"
                                               placeholder="Ej: Diabetes en el padre, hipertensión en la madre..."
                                               @bind-Value="historiaDto.AntecedentesFamiliares" />
                                <small class="text-muted">
                                    @(historiaDto.AntecedentesFamiliares?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaDto.AntecedentesFamiliares)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="antPers" class="form-label fw-semibold">
                                    <i class="fas fa-user-injured me-1"></i> Antecedentes Personales <span class="text-muted">(opcional)</span>
                                </label>
                                <InputTextArea id="antPers" class="form-control" rows="3"
                                               placeholder="Ej: Cirugía de apéndice en 2018, asma controlada..."
                                               @bind-Value="historiaDto.AntecedentesPersonales" />
                                <small class="text-muted">
                                    @(historiaDto.AntecedentesPersonales?.Length ?? 0) / 500 caracteres
                                </small>
                                <ValidationMessage For="@(() => historiaDto.AntecedentesPersonales)" class="text-danger small" />
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox id="activo" class="form-check-input"
                                               @bind-Value="historiaDto.Activo" />
                                <label for="activo" class="form-check-label fw-semibold">
                                    Historia clínica activa
                                </label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="fas fa-save me-1"></i> Guardar Historia
                                </button>
                            </div>
                        </EditForm>
                    }

                </div>
            </div>
        </div>
    </div>
</div>