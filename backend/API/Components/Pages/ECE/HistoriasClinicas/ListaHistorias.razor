@page "/historias-clinicas"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-notes-medical me-2"></i>Listado de Historias Clínicas
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nueva Historia Clínica
                </button>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (historias == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando historias clínicas...</p>
                </div>
            }
            else if (!historias.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No hay historias clínicas registradas.
                    <a href="/crear-historia" class="alert-link">Crear la primera</a>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Paciente</th>
                                <th><i class="fas fa-calendar-day me-1"></i> Fecha Apertura</th>
                                <th><i class="fas fa-allergies me-1"></i> Alergias</th>
                                <th><i class="fas fa-users me-1"></i> Antecedentes Familiares</th>
                                <th><i class="fas fa-flag me-1"></i> Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in historias)
                            {
                                <tr>
                                    <td class="fw-semibold">@h.NombrePaciente</td>
                                    <td>@h.FechaApertura.ToString("dd/MM/yyyy")</td>
                                    <td>@Truncar(h.Alergias)</td>
                                    <td>@Truncar(h.AntecedentesFamiliares)</td>
                                    <td>
                                        <span class="badge @(h.Activo ? "bg-success" : "bg-secondary")">
                                            @(h.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-info btn-sm text-white"
                                                title="Ver detalle"
                                                @onclick="() => NavegarADetalle(h.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-warning btn-sm text-white"
                                                title="Editar"
                                                @onclick="() => NavegarAEditar(h.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm"
                                                title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(h)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>