@page "/editar-cita/{Id:int}"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning bg-gradient text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Editar cita
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Cargando datos...</p>
                        </div>
                    }
                    else if (citaEditar == null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No se encontró la cita solicitada.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@citaEditar" OnValidSubmit="@GrabarCita" FormName="formEditarCita">
                            <FluentValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="paciente" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i> Paciente
                                    </label>
                                    <InputSelect id="paciente" class="form-select"
                                                 @bind-Value="citaEditar.IdPaciente">
                                        <option value="0">-- Selecciona un paciente --</option>
                                        @foreach (var pac in pacientes!)
                                        {
                                            <option value="@pac.Id">@pac.Nombres @pac.Apellidos</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => citaEditar.IdPaciente)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="doctor" class="form-label fw-semibold">
                                        <i class="fas fa-user-md me-1"></i> Doctor
                                    </label>
                                    <InputSelect id="doctor" class="form-select"
                                                 @bind-Value="citaEditar.IdDoctor">
                                        <option value="0">-- Selecciona un doctor --</option>
                                        @foreach (var doc in doctores!)
                                        {
                                            <option value="@doc.Id">@doc.NombreCompleto (@doc.NombreEspecialidad)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => citaEditar.IdDoctor)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="fecha" class="form-label fw-semibold">
                                        <i class="fas fa-calendar me-1"></i> Fecha
                                    </label>
                                    <InputDate id="fecha" class="form-control"
                                               @bind-Value="fechaSeleccionada"
                                               @bind-Value:after="SincronizarFechaHora" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="hora" class="form-label fw-semibold">
                                        <i class="fas fa-clock me-1"></i> Hora
                                    </label>
                                    <InputDate Type="InputDateType.Time" id="hora" class="form-control"
                                               @bind-Value="horaSeleccionada"
                                               @bind-Value:after="SincronizarFechaHora" />
                                </div>
                            </div>

                            <ValidationMessage For="@(() => citaEditar.FechaHora)" class="text-danger small mb-2" />

                            <div class="mb-3">
                                <label for="estado" class="form-label fw-semibold">
                                    <i class="fas fa-flag me-1"></i> Estado
                                </label>
                                <InputSelect id="estado" class="form-select" @bind-Value="citaEditar.Estado">
                                    @foreach (var item in EnumHelper.ObtenerOpcionesEnum<EstadoCita>())
                                    {
                                        <option value="@item.Value">@item.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => citaEditar.Estado)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="motivo" class="form-label fw-semibold">
                                    <i class="fas fa-notes-medical me-1"></i> Motivo de la cita
                                </label>
                                <InputTextArea id="motivo" class="form-control" rows="3"
                                               @bind-Value="citaEditar.Motivo" />
                                <ValidationMessage For="@(() => citaEditar.Motivo)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="notas" class="form-label fw-semibold">
                                    <i class="fas fa-sticky-note me-1"></i> Notas (opcional)
                                </label>
                                <InputTextArea id="notas" class="form-control" rows="2"
                                               @bind-Value="citaEditar.Notas" />
                                <ValidationMessage For="@(() => citaEditar.Notas)" class="text-danger small" />
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                    <i class="fas fa-times me-1"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="fas fa-save me-1"></i> Actualizar Cita
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>