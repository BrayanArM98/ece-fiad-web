@page "/citas"
@rendermode InteractiveServer
@using Dominio.Enumeraciones

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-calendar-check me-2"></i>Listado de Citas
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nueva Cita
                </button>
            </div>
        </div>
        <div class="card-body p-3 bg-primary-subtle">

            @if (citas == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando citas...</p>
                </div>
            }
            else if (!citas.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay citas registradas.
                    <a href="#" @onclick:preventDefault="true" @onclick="NavegarACrear">Crear la primera</a>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3 p-2">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Paciente</th>
                                <th>Doctor</th>
                                <th>Fecha y Hora</th>
                                <th>Motivo</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in citas)
                            {
                                <tr>
                                    <td>
                                        <i class="fas fa-user text-muted me-1"></i>
                                        <strong>@cita.NombrePaciente</strong>
                                    </td>
                                    <td>
                                        <i class="fas fa-user-md text-muted me-1"></i>
                                        @cita.NombreDoctor
                                    </td>
                                    <td>
                                        <i class="fas fa-clock text-muted me-1"></i>
                                        @cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(cita.Motivo))
                                        {
                                            <span class="text-muted fst-italic">Sin motivo</span>
                                        }
                                        else
                                        {
                                            @(cita.Motivo.Length > 50 ? cita.Motivo.Substring(0, 50) + "..." : cita.Motivo)
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @ObtenerColorEstado(cita.Estado)">
                                            @ObtenerTextoEstado(cita.Estado)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" title="Ver detalles"
                                                @onclick="() => VerDetalles(cita.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" title="Editar"
                                                @onclick="() => Editar(cita.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(cita.Id, cita.NombrePaciente, cita.FechaHora)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>