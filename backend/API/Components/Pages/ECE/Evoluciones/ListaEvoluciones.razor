@page "/evoluciones"
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-chart-line me-2"></i>
                    @if (IdHistoriaClinica.HasValue)
                    {
                        <span>Evoluciones de la Historia Clínica</span>
                    }
                    else
                    {
                        <span>Listado de Evoluciones</span>
                    }
                </h4>
                <div class="d-flex gap-2">
                    @if (IdHistoriaClinica.HasValue)
                    {
                        <button class="btn btn-light" @onclick="VerTodas">
                            <i class="fas fa-list me-1"></i> Ver todas
                        </button>
                    }
                    <button class="btn btn-success" @onclick="NavegarACrear">
                        <i class="fas fa-plus-circle me-1"></i> Nueva Evolución
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-3 bg-primary-subtle">
            @if (IdHistoriaClinica.HasValue && !string.IsNullOrEmpty(nombrePacienteFiltro))
            {
                <div class="alert alert-info mb-3">
                    <i class="fas fa-filter me-2"></i>
                    Mostrando evoluciones del paciente: <strong>@nombrePacienteFiltro</strong>
                </div>
            }

            @if (evoluciones == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando evoluciones...</p>
                </div>
            }
            else if (!evoluciones.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No hay evoluciones registradas.
                    <a href="/crear-evolucion" class="alert-link">Crear la primera</a>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Paciente</th>
                                <th><i class="fas fa-user-md me-1"></i> Doctor</th>
                                <th><i class="fas fa-calendar-day me-1"></i> Fecha</th>
                                <th><i class="fas fa-stethoscope me-1"></i> Diagnóstico</th>
                                <th><i class="fas fa-prescription-bottle-alt me-1"></i> Tratamiento</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in evoluciones)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.NombrePaciente</td>
                                    <td>
                                        @e.NombreDoctor
                                        <br />
                                        <small class="text-muted">@e.NombreEspecialidad</small>
                                    </td>
                                    <td>@e.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@Truncar(e.Diagnostico)</td>
                                    <td>@Truncar(e.Tratamiento)</td>
                                    <td class="text-center">
                                        <button class="btn btn-info btn-sm text-white"
                                                title="Ver detalle"
                                                @onclick="() => NavegarADetalle(e.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-warning btn-sm text-white"
                                                title="Editar"
                                                @onclick="() => NavegarAEditar(e.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm"
                                                title="Eliminar"
                                                @onclick="() => ConfirmarEliminar(e)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-end">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Total de evoluciones: <strong>@evoluciones.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>
</div>